<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'EdsDcfNet' Or '$(MSBuildProjectName)' == 'EdsDcfNet.Tests'">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    CS0618 is NOT suppressed project-wide for EdsDcfNet.Tests (#426).
    Dedicated facade/compat suites opt out via .editorconfig path rules.
  -->

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'EdsDcfNet'">
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>
</Project>
