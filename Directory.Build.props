<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'EdsDcfNet' Or '$(MSBuildProjectName)' == 'EdsDcfNet.Tests'">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    CS0618 is NOT suppressed project-wide for EdsDcfNet.Tests (#426).
    Dedicated facade/compat suites opt out via .editorconfig path rules.
  -->

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'EdsDcfNet'">
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <PropertyGroup Label="Versioning">
    <!--
      No project file carries a version. The build only ever receives one:

        * release  -> tools/semantic-release-publish.sh packs with -p:Version=X.Y.Z, the number
                      semantic-release derived from the conventional commits;
        * anything else (CI, a plain `dotnet build`, an IDE) -> VersionPrefix below.

      The restore never sees a release version. NuGet records the version of a referenced
      project in packages.lock.json (EdsDcfNet.Checker.Tests -> EdsDcfNet.Checker -> EdsDcfNet).
      A version committed per release would leave the lock files stale after every release,
      and the next ordinary restore would rewrite them in whatever change happens to come
      next. The release restores first and passes the version only to the pack, which runs
      with no restore.
    -->
    <VersionPrefix>0.0.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup Label="NuGet restore">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

</Project>
