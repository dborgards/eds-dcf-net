{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "semanticCommitType": "chore",
  "packageRules": [
    {
      "description": "Bump NuGet versions including exact/[bracket] pins (e.g. FluentAssertions [7.2.2]).",
      "matchManagers": [
        "nuget"
      ],
      "rangeStrategy": "bump"
    }
  ]
}
