<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>EdsDcfNet</PackageId>
		<Version>1.12.3-beta.1</Version>
		<Authors>Dietmar Borgards</Authors>
		<Description>A comprehensive C# .NET library for reading and writing CiA DS 306 (EDS, DCF, CPJ) and CiA 311 (XDD, XDC) files for CANopen devices.</Description>
		<PackageTags>CANopen;EDS;DCF;CPJ;XDD;XDC;CiA;DS306;CiA311;Industrial Automation</PackageTags>
		<RepositoryUrl>https://github.com/dborgards/eds-dcf-net</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
		<!-- Strong-named as of 1.13.0. The key is committed and public: it provides
		     assembly identity only, not authenticity. The SNK contains the private
		     key, so assemblies are fully signed on every platform (no PublicSign);
		     public signing would produce assemblies that fail strong-name
		     verification on .NET Framework. -->
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>EdsDcfNet.snk</AssemblyOriginatorKeyFile>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Strong-name public key of EdsDcfNet.snk, for the InternalsVisibleTo grant
		     to the (equally signed) test assembly. -->
		<EdsDcfNetPublicKey></EdsDcfNetPublicKey>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../../README.md" Pack="true" PackagePath="/" />
		<None Include="../../LICENSE" Pack="true" PackagePath="/" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="EdsDcfNet.Tests" Key="$(EdsDcfNetPublicKey)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.400">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All" />
		<PackageReference Include="Polyfill" Version="11.2.0" PrivateAssets="all">
		  <IncludeAssets>compile; build; analyzers; contentfiles</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
